# ==========================================
# KONFIGURASI GOPAY & QRIS PAYMENT GATEWAY
# Salin file ini menjadi .env lalu isi nilainya:
# cp .env.example .env
# ==========================================

# Port web server lokal
PORT=5050

# API Key rahasia untuk mengamankan endpoint backend (/api/v1/charge, /api/v1/transactions)
# Ganti dengan string acak yang kuat
API_KEY=your_secret_api_key_here

# QRIS Statis Merchant (Didapatkan dari aplikasi GoBiz / merchant e-wallet)
QRIS_STATIC=00020101021126610014COM.GO-JEK.WWW0118...YOUR_STATIC_QRIS_HERE...

# Merchant ID GoBiz Anda (Opsional: Kosongkan jika belum tahu)
GOPAY_MERCHANT_ID=G_YOUR_MERCHANT_ID_HERE

# Masa berlaku QRIS Dinamis dalam satuan menit (default: 15 menit)
EXPIRY_MINUTES=15

# Otomatis menambahkan kode unik 3 digit acak (true / false)
AUTO_UNIQUE_CODE=true
